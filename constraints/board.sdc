# ============================================================================
#  board.sdc —— 上板工程时序约束
#  50MHz 输入 -> PLL 75/375MHz；375MHz 的 slack 是真实指标，不要屏蔽
# ============================================================================

create_clock -name clk_50m -period 20 -waveform {0 10} [get_ports {clk_50m}]

# TD 读取 EG_PHY_PLL 的分频参数，自动推导 clk_pix / clk_ser
derive_clocks

# 像素域与串行域之间只有 lane_lvds_10_1 内部的 ODDR，
# 若报跨域违例，确认路径终点在 ODDR 之后，再决定是否屏蔽。
